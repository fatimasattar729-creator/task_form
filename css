form input[type="text"] {
    padding: 10px;
    border-radius: 6px;
    border: 1px solid rgb(52, 50, 50);
}

form input[type="button"] {
    padding: 10px;
    width: 70px;
    border-radius: 6px;
    border: 1px solid rgb(52, 50, 50);
}

form select {
    width: 180px;
    padding: 10px;
    border-radius: 6px;
    border: 1px solid rgb(52, 50, 50);
}

#add {
    color: white;
    background-color: rgb(48, 48, 217);
    border-radius: 6px;
    border: 1px solid rgb(52, 50, 50);
}
form{
    margin-bottom: 20px;
}
table,td,th{
    border: 1px solid black;
    border-collapse: collapse;
}
th{
    color: white;
    background-color: black;
    border-color: rgb(81, 75, 75);
}
td,th{
    width: 150px;
    padding: 10px;
}
#action1,#action2{
    padding: 5px;
    border: 1px solid black;
    border-radius: 5px;
}
#action1{
    background-color: yellow;
    color: black;
}
#action2{
    background-color: rgb(242, 44, 61);
    color: rgb(252, 250, 250);
}
